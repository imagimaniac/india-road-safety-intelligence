# Copy to .env and fill in only if a source requires a token.
# NEVER commit a filled .env. This project uses NO external LLM by default.

# Optional: some data.gov.in API calls request an API key.
# DATA_GOV_IN_API_KEY=

# Optional: override the HTTP contact user-agent (keep it honest).
# IRSI_USER_AGENT=

# Optional: local LLM endpoint (disabled unless explicitly enabled in settings).
# OLLAMA_BASE_URL=http://localhost:11434
