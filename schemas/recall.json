{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "recall",
  "additionalProperties": false,
  "required": [
    "make_slug",
    "defect",
    "source_slug",
    "confidence"
  ],
  "properties": {
    "make_slug": {
      "type": "string"
    },
    "model_slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "year_range": {
      "type": [
        "string",
        "null"
      ]
    },
    "defect": {
      "type": "string"
    },
    "remedy": {
      "type": [
        "string",
        "null"
      ]
    },
    "announced_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unverified"
      ]
    }
  }
}