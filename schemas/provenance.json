{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "provenance",
  "additionalProperties": false,
  "required": [
    "source_slug",
    "retrieved_at",
    "method"
  ],
  "properties": {
    "source_slug": {
      "type": "string"
    },
    "source_url": {
      "type": ["string", "null"]
    },
    "document_id": {
      "type": ["integer", "null"]
    },
    "retrieved_at": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "http_status": {
      "type": ["integer", "null"]
    },
    "content_sha256": {
      "type": ["string", "null"]
    },
    "note": {
      "type": ["string", "null"]
    }
  }
}