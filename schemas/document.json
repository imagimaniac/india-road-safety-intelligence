{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "document",
  "additionalProperties": false,
  "required": [
    "source_slug",
    "url",
    "retrieved_at"
  ],
  "properties": {
    "source_slug": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "title": {
      "type": ["string", "null"]
    },
    "doc_type": {
      "type": ["string", "null"]
    },
    "published_on": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "retrieved_at": {
      "type": "string"
    },
    "content_sha256": {
      "type": ["string", "null"]
    },
    "raw_path": {
      "type": ["string", "null"]
    },
    "meta": {
      "type": ["object", "null"]
    }
  }
}